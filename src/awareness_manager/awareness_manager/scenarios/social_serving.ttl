# --- Instance relational edges ---

# Children at the same table
[] a am:InstanceEdge ;
   am:source am:person_01 ; am:target am:person_02 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

[] a am:InstanceEdge ;
   am:source am:person_02 ; am:target am:person_03 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

# Adults at the bar area
[] a am:InstanceEdge ;
   am:source am:person_04 ; am:target am:person_05 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

[] a am:InstanceEdge ;
   am:source am:person_05 ; am:target am:person_06 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

# VIPs together at the reserved table
[] a am:InstanceEdge ;
   am:source am:person_07 ; am:target am:person_08 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

# Multi-class adults/VIPs near the VIP table
[] a am:InstanceEdge ;
   am:source am:person_09 ; am:target am:person_07 ;
   am:weight "1.5"^^xsd:double ; am:relationType "locatedNear" .

[] a am:InstanceEdge ;
   am:source am:person_10 ; am:target am:person_08 ;
   am:weight "1.5"^^xsd:double ; am:relationType "locatedNear" .

# Drink containers clustered together at the restock zone
[] a am:InstanceEdge ;
