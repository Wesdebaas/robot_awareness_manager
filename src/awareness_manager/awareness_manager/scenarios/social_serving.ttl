@prefix am: <http://coresense.eu/awareness/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# Social Serving Scenario Ontology
# CoreSense — robot serving drinks to 10 people at a social event
#
# Designed to exercise F6 (Spatial Opportunity Cost):
#   - Two zones: table_area (people) and restock_zone (drinks)
#   - Cross-zone travel is expensive → AM learns to batch observations
#   - Multi-class people (adult+VIP) boost attention from both classes
#   - Runtime instance churn: drinks taken by others, people finish drinks
#   - Metric: total accumulated person-seconds without a drink
#
# Decay rates (δ, s⁻¹):
#   0.0   task/class nodes  — abstract goals and derived classes, no drift
#   0.005 restock_zone      — stable location, rarely changes
#   0.01  table_area        — seating area, people cluster here
#   0.04  person instances  — state changes (finish drink) on ~25s timescale
#   0.05  drink instances   — bottles/glasses can disappear on ~20s timescale
#
# Observation costs (am:observationCost, seconds):
#   2.0   person instances  — state assessment (has_drink, thirst level)
#   0.5   drink instances   — quick visual stock check
#   1.0   location concepts — area scan
#   (class/task nodes: omitted → default 1.0, never scheduled)
#
# Zone assignment (am:zone):
#   "table_area"   — person instances, table_area concept
#   "restock_zone" — drink instances, restock_zone concept
# ============================================================


# --- Primary mission goal (always active) ---

am:serve_people_drinks a am:Concept ;
    am:conceptId "serve_people_drinks" ;
    am:conceptType "task" ;
    am:decayRate "0.0"^^xsd:double .


# --- Person classes (derived from person instances) ---

am:child a am:Concept ;
    am:conceptId "child" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

am:adult a am:Concept ;
    am:conceptId "adult" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

am:VIP a am:Concept ;
    am:conceptId "VIP" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

# Generic person class — used by parameterised serve goals to keep person awareness.
am:person a am:Concept ;
    am:conceptId "person" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .


# --- Drink classes (derived from drink container instances) ---

am:juice a am:Concept ;
    am:conceptId "juice" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

am:cola a am:Concept ;
    am:conceptId "cola" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

am:beer a am:Concept ;
    am:conceptId "beer" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

am:wine a am:Concept ;
    am:conceptId "wine" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .

am:champagne a am:Concept ;
    am:conceptId "champagne" ;
    am:conceptType "object" ;
    am:decayRate "0.0"^^xsd:double ;
    am:classEMode "derived" ;
    am:derivedAggregation "mean" ;
    am:absentFallbackE "1.0"^^xsd:double .


# --- Location concepts ---

am:restock_zone a am:Concept ;
    am:conceptId "restock_zone" ;
    am:conceptType "location" ;
    am:decayRate "0.005"^^xsd:double ;
    am:observationCost "1.0"^^xsd:double ;
    am:zone "restock_zone" .

am:table_area a am:Concept ;
    am:conceptId "table_area" ;
    am:conceptType "location" ;
    am:decayRate "0.01"^^xsd:double ;
    am:observationCost "1.0"^^xsd:double ;
    am:zone "table_area" .


# --- Semantic edges from primary goal ---

# serve_people_drinks → person classes (all people need drinks)
[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:child ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:adult ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:VIP ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:person ; am:weight "1.0"^^xsd:double .

# serve_people_drinks → drink classes (knowing stock is directly relevant)
[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:juice ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:cola ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:beer ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:wine ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:champagne ; am:weight "1.0"^^xsd:double .

# serve_people_drinks → locations (less direct, higher weight)
[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:restock_zone ; am:weight "2.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:serve_people_drinks ; am:target am:table_area ; am:weight "2.0"^^xsd:double .

# Person class → drink preference edges (2-hop paths via F1)
[] a am:SemanticEdge ;
   am:source am:child ; am:target am:juice ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:child ; am:target am:cola ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:adult ; am:target am:beer ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:adult ; am:target am:wine ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:VIP ; am:target am:champagne ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:VIP ; am:target am:wine ; am:weight "1.5"^^xsd:double .

# Location structural edges
[] a am:SemanticEdge ;
   am:source am:table_area ; am:target am:child ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:table_area ; am:target am:adult ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:table_area ; am:target am:VIP ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:restock_zone ; am:target am:juice ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:restock_zone ; am:target am:cola ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:restock_zone ; am:target am:beer ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:restock_zone ; am:target am:wine ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:restock_zone ; am:target am:champagne ; am:weight "1.0"^^xsd:double .


# --- Person instances ---
# 3 children, 3 adults, 2 VIPs, 2 adult+VIP (multi-class)
# All in zone "table_area", observation cost 2.0s (state assessment)

am:person_01 a am:InstanceConcept ;
    am:conceptId "person_01" ; am:conceptType "object" ;
    am:decayRate "0.04"^^xsd:double ; am:classId "child" ;
    am:classId "person" ;
    am:observationCost "2.0"^^xsd:double ;
    am:urgencyRate "0.02"^^xsd:double ;
    am:zone "table_area" .

am:person_02 a am:InstanceConcept ;
    am:conceptId "person_02" ; am:conceptType "object" ;
    am:decayRate "0.04"^^xsd:double ; am:classId "child" ;
