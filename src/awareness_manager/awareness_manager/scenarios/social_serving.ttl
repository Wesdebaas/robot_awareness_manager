   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

[] a am:InstanceEdge ;
   am:source am:beer_02 ; am:target am:beer_03 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

[] a am:InstanceEdge ;
   am:source am:wine_01 ; am:target am:wine_02 ;
   am:weight "1.0"^^xsd:double ; am:relationType "locatedNear" .

[] a am:InstanceEdge ;
   am:source am:wine_01 ; am:target am:champagne_01 ;
   am:weight "1.5"^^xsd:double ; am:relationType "locatedNear" .

