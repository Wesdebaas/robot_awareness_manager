@prefix am:  <http://coresense.eu/awareness/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# Find My Book — awareness scenario ontology
#
# A domestic robot navigates a multi-room house to locate a book.
# Demonstrates: F1 (spreading activation across room adjacency graph),
# F2 (anticipatory pre-tuning when nav goal is set), F5 (epistemic
# error drives which room to search first), F6 (books in the current
# room are cheapest to observe).
#
# Room topology (KRR_Course_Small_house):
#   find_book → living_room ── kitchen
#                    │
#               bathroom
#                    │
#               bedroom ── study
#
# Decay rates (δ, s⁻¹):
#   0.0   task / class nodes   — abstract, no drift
#   0.05  room concepts        — room state changes slowly
#   0.25  book instances       — books are moved by people, E grows fast
#
# Observation costs (seconds, proxy for travel):
#   1.0   living_room   — robot starts here
#   1.5   kitchen       — one room away
#   1.8   bathroom      — one room away
#   2.0   bedroom       — two rooms away
#   2.5   study         — furthest room
# ============================================================


# ── Mission goal ─────────────────────────────────────────────────────────────

am:find_book a am:Concept ;
    am:conceptId   "find_book" ;
    am:conceptType "task" ;
    am:decayRate   "0.0"^^xsd:double .


# ── Room concepts ─────────────────────────────────────────────────────────────

am:living_room a am:Concept ;
    am:conceptId        "living_room" ;
    am:conceptType      "location" ;
    am:decayRate        "0.05"^^xsd:double ;
    am:zone             "living_room" ;
    am:observationCost  "1.0"^^xsd:double .

am:kitchen a am:Concept ;
    am:conceptId        "kitchen" ;
    am:conceptType      "location" ;
    am:decayRate        "0.05"^^xsd:double ;
    am:zone             "kitchen" ;
    am:observationCost  "1.5"^^xsd:double .

am:bathroom a am:Concept ;
    am:conceptId        "bathroom" ;
    am:conceptType      "location" ;
    am:decayRate        "0.05"^^xsd:double ;
    am:zone             "bathroom" ;
    am:observationCost  "1.8"^^xsd:double .

am:bedroom a am:Concept ;
    am:conceptId        "bedroom" ;
    am:conceptType      "location" ;
    am:decayRate        "0.05"^^xsd:double ;
    am:zone             "bedroom" ;
    am:observationCost  "2.0"^^xsd:double .

am:study a am:Concept ;
    am:conceptId        "study" ;
    am:conceptType      "location" ;
    am:decayRate        "0.05"^^xsd:double ;
    am:zone             "study" ;
    am:observationCost  "2.5"^^xsd:double .


# ── Book class (abstract — never scheduled directly) ──────────────────────────

am:book_class a am:Concept ;
    am:conceptId   "book_class" ;
    am:conceptType "object_class" ;
    am:decayRate   "0.0"^^xsd:double .


# ── Person class ──────────────────────────────────────────────────────────────

am:person a am:Concept ;
    am:conceptId   "person" ;
    am:conceptType "person" ;
    am:decayRate   "0.02"^^xsd:double .


# ── Semantic edges ────────────────────────────────────────────────────────────

# Goal → rooms (1-hop; robot must search rooms to find the book)
[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:living_room ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:kitchen ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:bathroom ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:bedroom ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:study ; am:weight "1.0"^^xsd:double .

# Goal → book class
[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:book_class ; am:weight "1.0"^^xsd:double .

# Goal → person (owner who requested the book)
[] a am:SemanticEdge ;
   am:source am:find_book ; am:target am:person ; am:weight "2.0"^^xsd:double .

# Room adjacency edges (F1 spreading activation can propagate across rooms)
[] a am:SemanticEdge ;
   am:source am:living_room ; am:target am:kitchen ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:living_room ; am:target am:bathroom ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:living_room ; am:target am:bedroom ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:bedroom ; am:target am:study ; am:weight "1.0"^^xsd:double .

# Room → book class (being in a room means you can look for the book there)
[] a am:SemanticEdge ;
   am:source am:living_room ; am:target am:book_class ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:kitchen ; am:target am:book_class ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:bedroom ; am:target am:book_class ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:study ; am:target am:book_class ; am:weight "1.0"^^xsd:double .

[] a am:SemanticEdge ;
   am:source am:bathroom ; am:target am:book_class ; am:weight "1.5"^^xsd:double .


# ── Book instances (one per room) ─────────────────────────────────────────────

am:book_living_room a am:InstanceConcept ;
    am:conceptId        "book_living_room" ;
    am:conceptType      "object" ;
    am:decayRate        "0.25"^^xsd:double ;
    am:classId          "book_class" ;
    am:zone             "living_room" ;
    am:observationCost  "1.0"^^xsd:double ;
    am:urgencyRate      "0.0"^^xsd:double .

am:book_kitchen a am:InstanceConcept ;
    am:conceptId        "book_kitchen" ;
    am:conceptType      "object" ;
    am:decayRate        "0.25"^^xsd:double ;
    am:classId          "book_class" ;
    am:zone             "kitchen" ;
    am:observationCost  "1.5"^^xsd:double ;
    am:urgencyRate      "0.0"^^xsd:double .

am:book_bedroom a am:InstanceConcept ;
    am:conceptId        "book_bedroom" ;
    am:conceptType      "object" ;
    am:decayRate        "0.25"^^xsd:double ;
    am:classId          "book_class" ;
    am:zone             "bedroom" ;
    am:observationCost  "2.0"^^xsd:double ;
    am:urgencyRate      "0.0"^^xsd:double .

am:book_study a am:InstanceConcept ;
    am:conceptId        "book_study" ;
    am:conceptType      "object" ;
    am:decayRate        "0.25"^^xsd:double ;
    am:classId          "book_class" ;
    am:zone             "study" ;
    am:observationCost  "2.5"^^xsd:double ;
    am:urgencyRate      "0.0"^^xsd:double .

am:book_bathroom a am:InstanceConcept ;
    am:conceptId        "book_bathroom" ;
    am:conceptType      "object" ;
    am:decayRate        "0.25"^^xsd:double ;
    am:classId          "book_class" ;
    am:zone             "bathroom" ;
    am:observationCost  "1.8"^^xsd:double ;
    am:urgencyRate      "0.0"^^xsd:double .


# ── Owner instance ────────────────────────────────────────────────────────────

am:owner a am:InstanceConcept ;
    am:conceptId        "owner" ;
    am:conceptType      "person" ;
    am:decayRate        "0.05"^^xsd:double ;
    am:classId          "person" ;
    am:zone             "living_room" ;
    am:observationCost  "1.0"^^xsd:double ;
    am:urgencyRate      "0.01"^^xsd:double .
