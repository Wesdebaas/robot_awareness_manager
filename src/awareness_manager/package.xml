<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>awareness_manager</name>
  <version>0.0.1</version>
  <description>
    Top-down robot awareness management system for cognitive robotics.
    Implements a knowledge base with spreading activation, temporal decay,
    and mission-driven attention allocation based on grounding formulas.
  </description>
  <maintainer email="wesselremmelzwaan@gmail.com">Wessel</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
